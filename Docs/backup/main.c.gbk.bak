// 串口收发缓冲区
uint8_t aRxBuffer[1];          // 单字节接收缓冲
uint8_t aTxBuffer[] = "Delta Robot Boot OK\r\n";

// 诊断用计数器
uint32_t aliveCnt = 0;

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
/* USER CODE BEGIN PFP */
static void USART1_UsePins(GPIO_TypeDef *port, uint16_t pins);
